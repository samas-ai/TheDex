# EAS Build uploads the repository using this file instead of .gitignore.
# Same as .gitignore, EXCEPT the generated game database, which the app bundles
# (apps/mobile/assets/db/thedex-data.db — produce it with `pnpm data:build` first).
node_modules/
.pnpm-store/
dist/
coverage/
.turbo/
.cache/
*.tsbuildinfo
tools/data-pipeline/dist/
apps/mobile/.expo/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/web-build/
.env
.env.*
!.env.example
